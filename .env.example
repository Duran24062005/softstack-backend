MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=softstack
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=0
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Transactional email provider
EMAIL_SERVICE_URL=https://email-python-fast-api.vercel.app
EMAIL_SERVICE_API_KEY=replace-with-a-long-random-secret
EMAIL_REQUEST_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASH_SCHEME=argon2id
# Comma-separated emails promoted to admin on registration. Example:
# ADMIN_EMAILS=you@example.com,another-admin@example.com
ADMIN_EMAILS=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Leave empty when authentication is proxied by the Next.js frontend BFF.
COOKIE_DOMAIN=
ACCESS_COOKIE_NAME=softstack_access
REFRESH_COOKIE_NAME=softstack_refresh

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
BLOB_STORE_ID="store_**************"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_******************************"

# Public Blob Store dedicated to content images, videos and module covers.
CONTENT_BLOB_STORE_ID="store_**************"
CONTENT_BLOB_READ_WRITE_TOKEN="vercel_blob_rw_******************************"
CONTENT_BLOB_PUBLIC_HOST="example.public.blob.vercel-storage.com"
CONTENT_BLOB_MAX_IMAGE_SIZE_BYTES=10000000
CONTENT_BLOB_MAX_VIDEO_SIZE_BYTES=100000000
CONTENT_BLOB_IMPORT_TIMEOUT_SECONDS=10
CONTENT_BLOB_ORPHAN_RETENTION_HOURS=24
CRON_SECRET="replace-with-a-long-random-secret"
